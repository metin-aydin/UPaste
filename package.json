{
  "name": "upaste",
  "productName": "UPaste",
  "desktopName": "upaste.desktop",
  "version": "0.1.10",
  "description": "Searchable clipboard history for text and images: press one shortcut in any text field to find and paste what you copied before",
  "main": "./out/main/index.js",
  "author": "metin-aydin",
  "license": "MIT",
  "homepage": "https://github.com/metin-aydin/UPaste",
  "repository": {
    "type": "git",
    "url": "https://github.com/metin-aydin/UPaste.git"
  },
  "bugs": "https://github.com/metin-aydin/UPaste/issues",
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "linux",
    "ubuntu",
    "gnome",
    "wayland",
    "super-v",
    "win-v",
    "electron"
  ],
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview -- --ozone-platform=x11 --log-level=3",
    "dev": "electron-vite dev -- --ozone-platform=x11 --log-level=3",
    "build": "npm run typecheck && electron-vite build",
    "build:linux": "npm run build && electron-builder --linux",
    "test:unit": "node dev/run-unit-tests.mjs",
    "icons": "sh dev/render-icons.sh"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "lucide-react": "^1.61.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
